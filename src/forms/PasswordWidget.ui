   <string notr="true">QWidget{
	background: rgb(30, 30, 30);
	color: rgb(244, 244, 244);
	font: 12pt &quot;Arial&quot;;
}
QWidget:disabled{
	color: rgb(100, 100, 100);
}

/* LABEL */
QLabel{
	max-width: 100px;
	min-width: 100px;
	min-height: 24px;
	max-height: 24px;
}
#passwordInfoLabel, #confirmInfoLabel, #optionInfoLabel, #iterationInfoLabel, #hmacInfoLabel{
	color: rgb(200, 200, 200);
	max-width: 2000px;
	min-height: 0px;
	max-height: 100px;
	font: 9pt;
}


QLineEdit{
	font: 10pt;
	padding-left: 4px;
	border: 1px solid rgb(70, 70, 70);
	border-radius: 4px;
	min-height: 24px;
	max-height: 24px;
}

QCheckBox{
	padding-left: 1px;
	background: transparent;
	font: 10pt;
	color: rgb(255, 255, 255);
}QCheckBox::indicator{
	background: rgb(50, 50, 50);
	border: 1px solid rgb(70, 70, 70);
}QCheckBox::indicator::checked{
	background: rgb(55, 255, 55);
}


/* button */
QPushButton{
	font: 11pt;
	min-height: 24px;
	background: rgb(40, 40, 40);
	border: 1px solid rgb(70, 70, 70);
	border-radius: 4px;
}QPushButton:hover{
	background: rgb(60, 60, 60);
}
QPushButton::pressed{
	background: rgb(40, 40, 40);
}
#CreateButton{
	min-width: 200px;
	max-width: 200px;
}

#AditionalEncryptionInfoButton{
	color: rgb(0, 0, 255);
	font: 11pt;
	text-decoration: underline;
	border: 0px;
	max-width: 85px;
	background: transparent;
}#AditionalEncryptionInfoButton:hover{
	background: transparent;
}#AditionalEncryptionInfoButton::pressed{
	background: transparent;
	color: rgb(0, 0, 100);
}
#BackButton{
	max-height: 20px;
	min-height: 20px;
	font: 11pt;
}



#passwordVisibilityButton, #confirmVisibilityButton{
	max-height: 24px;
	min-height: 24px;
	max-width: 24px;
	min-width: 24px;
}



#line, #line_2{
	background: rgb(70, 70, 70);
	border: 0px;
	max-height:1px;
	min-height:1px;
	max-width: 2000px;
	min-width: 0px;
}
